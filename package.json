{
  "name": "cobalt-instrument-studio",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:ci": "vitest run --reporter=default --reporter=json --outputFile=.local/unit-results.json",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "build": "node scripts/sync-reports.mjs && tsc --noEmit && vite build",
    "build:pages": "node scripts/build-pages.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "verify:privacy": "node scripts/verify-privacy.mjs",
    "verify:workflows": "node scripts/verify-config.mjs",
    "verify:paths": "node scripts/verify-source-paths.mjs",
    "verify:static": "node scripts/validate-static-builds.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^3.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.2",
    "prettier": "^3.9.10",
    "typescript": "^5.9.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "yaml": "^2.9.1"
  }
}
